export component ArtistCard inherits Rectangle {
    in property <string> artist-name;
    in property <image> artist-image;
    in property <string> description;

    width: 180px;
    height: 240px;
    background: #252525;
    border-radius: 12px;

    VerticalLayout {
        spacing: 8px;
        padding: 10px;

        Rectangle {
            width: 100%;
            height: 150px;
            border-radius: 10px;
            clip: true;

            Image {
                source: root.artist-image;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }

        Text {
            text: root.artist-name;
            color: white;
            font-size: 18px;
            font-weight: 700;
        }

        Text {
            text: root.description;
            color: #aaaaaa;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}
